---
import StarlightPage from "@astrojs/starlight/components/StarlightPage.astro";
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<StarlightPage frontmatter={{ title: "Playground", description: "Watch the same message be delivered, deferred and stopped, and see which check decided. Runs the real package in your browser; nothing leaves the page." }}>
  <p>
    The real package, bundled for the browser with an in-memory store. Nothing is sent anywhere and
    there is no key to enter. Start with a scenario: each one changes the situation, not the
    message, and the verdict changes with it. The policy and the input for whichever scenario you
    picked stay editable below, so you can take any of them apart.
  </p>
  <p>
    Eight of these scenarios run under one policy about the things you actually control: whether
    the user consented, their operating mode, their snooze, their quiet hours, how new the account
    is, and your own daily limit. The ninth carries a commercial-communication preset and runs
    under its own policy, because that answers a different question and only applies to a
    different kind of message. Picking it says what it covers.
  </p>

  <div id="scenarios" class="scen"></div>

  <!-- Shown only for a scenario that carries a regulatory preset. The text comes from the
       scenario's own scope note and from the preset's `note` and `sources` in the library,
       so it cannot drift away from what the preset actually encodes. -->
  <div id="scopebox" class="scopebox" hidden>
    <p id="scope" class="scope"></p>
    <p id="scopesrc" class="scopesrc"></p>
  </div>

  <div id="out" hidden>
    <div id="banner" class="banner">
      <p id="verdict" class="verdict"></p>
      <p id="summary" class="summary"></p>
    </div>
    <table class="trace">
      <thead><tr><th class="n">#</th><th>check</th><th>outcome</th><th>reason</th><th class="ms">ms</th></tr></thead>
      <tbody id="rows"></tbody>
    </table>
  </div>
  <p id="error" class="error" hidden></p>

  <details class="src" open>
    <summary>The policy and the input behind this run</summary>
    <div class="pg">
      <label>Policy <textarea id="policy" rows="14" spellcheck="false"></textarea></label>
      <label>Input <textarea id="input" rows="14" spellcheck="false"></textarea></label>
    </div>
    <p class="acts">
      <button id="run" class="run">Run</button>
      <button id="copy" class="copy">Copy the policy</button>
      <span id="status"></span>
    </p>
  </details>

  <details class="src ex">
    <summary>Take this run with you</summary>
    <p class="hint">
      These are built from the two boxes above, so they carry the run in front of you rather than
      a sample. There is no share link on purpose: the input can hold a user id, a payload, event
      text or someone's real quiet hours, and a link is copied into chat logs and kept in browser
      history. Save the files instead.
    </p>
    <label>Install it <textarea id="ex-install" rows="1" readonly spellcheck="false"></textarea></label>
    <label>Replay a file of candidates through this policy <textarea id="ex-replay" rows="2" readonly spellcheck="false"></textarea></label>
    <label>Wire it into your own send, as run.mjs beside the policy file <textarea id="ex-snippet" rows="20" readonly spellcheck="false"></textarea></label>
    <p class="acts">
      <button id="copy-install" class="copy">Copy the install</button>
      <button id="copy-replay" class="copy">Copy the command</button>
      <button id="copy-snippet" class="copy">Copy the snippet</button>
      <span id="ex-status"></span>
    </p>
  </details>

  <script is:inline define:vars={{ base }}>
    const $ = (id) => document.getElementById(id);

    let mod;
    const load = async () => (mod ??= await import(`${base}/playground/gate.js`));

    // The trace table and the scenario buttons are built as DOM nodes, never as a string of
    // HTML. A trace reason is assembled by the library from values that reach it from the Input
    // textarea below (quietHours builds its reason from user.timezone), so caller text reaches
    // this render path. test/playground-render.test.mjs holds it to text.
    let ui;
    const loadUi = async () => (ui ??= await import(`${base}/playground/trace-table.mjs`));

    // The scenarios, the two policies behind them and the run logic live in a module beside
    // this page, because test/playground-scenarios.test.mjs runs those exact scenarios through
    // the real library. Every verdict these labels imply is therefore measured rather than
    // transcribed, and the page keeps no second copy of the data that could drift from it.
    let data;
    const loadData = async () => (data ??= await import(`${base}/playground/scenarios.mjs`));

    // The policy file, the replay command and the wire-up snippet. Pure functions of the policy
    // and the input, and test/snippet.test.mjs executes the snippet it produces against the
    // built package, so what this page offers is a snippet that runs.
    let ex;
    const loadExport = async () => (ex ??= await import(`${base}/playground/export.mjs`));

    async function run() {
      $("error").hidden = true;
      $("status").textContent = "running";
      try {
        const m = await load();
        const p = JSON.parse($("policy").value);
        const i = JSON.parse($("input").value);
        await refreshExport(i);

        // Whatever is in those two boxes goes through the same function the test runs, so the
        // page and the test cannot diverge. The budget is spent the only way it can honestly
        // be spent, by committing real decisions first; nothing pre-loads a counter behind the
        // library's back.
        const d = await (await loadData()).evaluateWithPrespend(m, p, i);
        const stoppedBy = d.rejectedBy ?? d.deferredBy;
        // classList, not className: assigning className would drop the class Astro stamps on this
        // element to scope the stylesheet, and the verdict would lose its colour along with it.
        const tone = d.allowed ? "go" : d.deferredBy ? "wait" : "stop";
        for (const el of [$("verdict"), $("banner")]) {
          el.classList.remove("go", "wait", "stop");
          el.classList.add(tone);
        }
        $("verdict").textContent = d.allowed
          ? `\u2713 allowed \u2192 ${d.surfaces.join(", ")}`
          : d.deferredBy
            ? `\u2192 deferred by ${d.deferredBy}`
            : `\u2717 rejected by ${d.rejectedBy}`;
        // Separated rather than stacked: three parenthetical clauses in a row read as an error
        // message that lost its formatting.
        $("summary").textContent = [
          d.reason ?? `${d.trace.length} checks ran, none blocked delivery`,
          i.deliveredToday ? `${i.deliveredToday} already delivered today` : "",
          d.shadowed?.length ? `shadowed: ${d.shadowed.join(", ")}` : "",
        ].filter(Boolean).join("  \u00b7  ");
        // The glyph vocabulary lives in the render module now, so the demo, the terminal and
        // the figure in the README still read as one tool rather than three.
        (await loadUi()).renderTraceTable($("rows"), d.trace, stoppedBy, document);
        $("out").hidden = false;
        $("status").textContent = "";
      } catch (e) {
        $("status").textContent = "";
        $("error").textContent = e && e.message ? e.message : String(e);
        $("error").hidden = false;
      }
    }

    async function pick(key) {
      const d = await loadData();
      const s = d.scenarios.find((x) => x.key === key) ?? d.scenarios[0];
      for (const b of document.querySelectorAll(".scen-b")) b.classList.toggle("on", b.dataset.key === s.key);
      // Each scenario names the policy it runs under, so picking one shows the policy that
      // actually produced the verdict rather than one shared policy for all nine.
      $("policy").value = JSON.stringify(d.policyFor(s), null, 2);
      $("input").value = JSON.stringify(d.inputFor(s), null, 2);
      await showScope(s, d);
      run();
    }

    // Scope for a scenario that carries a regulatory preset, and nothing at all for one that
    // does not. The sentence is the scenario's own; the note and the sources are the preset's,
    // read out of the library so they cannot drift from what it encodes. Nothing here states a
    // conclusion about anyone's obligations, and there is no badge to earn.
    async function showScope(s, d) {
      if (!s.scope) {
        $("scopebox").hidden = true;
        return;
      }
      const m = await load();
      const preset = s.preset ? m.presets[s.preset] : undefined;
      $("scope").textContent = s.scope;
      $("scopesrc").textContent = [
        preset ? `${s.preset}: ${preset.note}` : "",
        preset && preset.sources && preset.sources.length ? `Sources: ${preset.sources.join("  ")}` : "",
        `Wording last checked against the preset's own note and sources on ${d.SCOPE_CHECKED}.`,
      ].filter(Boolean).join("  ·  ");
      $("scopebox").hidden = false;
    }

    $("scenarios").addEventListener("click", (e) => {
      const b = e.target.closest(".scen-b");
      if (b) pick(b.dataset.key);
    });
    // Rebuilt from whatever is in the boxes, so editing the policy and pressing Run changes
    // what you would copy. Nothing is written to a URL here or anywhere else on this page.
    async function refreshExport(input) {
      const x = await loadExport();
      $("ex-install").value = x.installCommand;
      $("ex-replay").value = x.replayCommand;
      $("ex-snippet").value = x.wireUpSnippet(input);
    }

    /** Copy a field, and say so in plain words when the clipboard is not reachable. */
    function wireCopy(buttonId, sourceId, statusId, done) {
      $(buttonId).addEventListener("click", async () => {
        try {
          await navigator.clipboard.writeText($(sourceId).value);
          $(statusId).textContent = done;
          setTimeout(() => ($(statusId).textContent = ""), 4000);
        } catch {
          $(statusId).textContent = "could not reach the clipboard; select the text and copy it";
        }
      });
    }

    $("run").addEventListener("click", run);
    wireCopy("copy", "policy", "status", "policy copied; save it as proactive-gate.policy.json");
    wireCopy("copy-install", "ex-install", "ex-status", "copied");
    wireCopy("copy-replay", "ex-replay", "ex-status", "copied; run it beside the policy file and a day.jsonl");
    wireCopy("copy-snippet", "ex-snippet", "ex-status", "copied; save it as run.mjs beside the policy file");

    // The buttons have to exist before pick() can mark one of them current, so the first
    // render and the first run are one sequence. If the render module cannot be fetched the
    // page says so rather than showing an empty strip of nothing.
    (async () => {
      try {
        const d = await loadData();
        (await loadUi()).renderScenarioButtons($("scenarios"), d.scenarios, document);
        await pick("ok");
      } catch (e) {
        $("error").textContent = e && e.message ? e.message : String(e);
        $("error").hidden = false;
      }
    })();
  </script>

  <style is:global>
    #scenarios .scen-b { font: inherit; text-align: left; padding: 0.45rem 0.7rem; border: 1px solid var(--sl-color-gray-5); border-radius: 0.25rem; background: transparent; color: var(--sl-color-white); cursor: pointer; }
    #scenarios .scen-b:hover { border-color: var(--sl-color-accent); }
    #scenarios .scen-b.on { border-color: var(--sl-color-accent); background: color-mix(in srgb, var(--sl-color-accent) 16%, transparent); }
    #scenarios .scen-b .scen-l { display: block; font-size: 0.9rem; font-weight: 600; line-height: 1.35; }
    #scenarios .scen-b .scen-n { display: block; font-size: 0.75rem; color: var(--sl-color-gray-3); line-height: 1.35; }
    /* The trace reads like the CLI: a glyph carries the outcome, the check name is mono, the cost
       is right-aligned, and only the row that stopped the message is filled. */
    #rows td { vertical-align: top; }
    #rows td.n, #rows td.ms { text-align: right; color: var(--sl-color-gray-3); font-variant-numeric: tabular-nums; white-space: nowrap; }
    #rows td.oc { white-space: nowrap; }
    #rows td.oc .g { display: inline-block; width: 1em; font-weight: 700; }
    #rows td.rs { color: var(--sl-color-gray-2); }
    #rows td.oc .sh { font-size: 0.8em; color: var(--sl-color-gray-3); border: 1px solid var(--sl-color-gray-5); border-radius: 3px; padding: 0 0.3em; }
    #rows tr.o-pass td.oc { color: var(--sl-color-green-high); }
    #rows tr.o-skip td.oc, #rows tr.o-defer td.oc { color: var(--sl-color-orange-high); }
    #rows tr.stop td { background: color-mix(in srgb, var(--sl-color-red) 16%, transparent); }
    #rows tr.stop td.oc { color: var(--sl-color-red-high); font-weight: 600; }
    #rows tr.shadow td { opacity: 0.7; }
  </style>

  <style>
    .scen { display: grid; grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr)); gap: 0.5rem; margin: 1.25rem 0; }
    /* Scope, not decoration: a neutral box rather than a warning colour, because this says
       what the example covers and it is not a verdict about anyone's obligations. */
    .scopebox { border: 1px solid var(--sl-color-gray-5); border-radius: 4px; padding: 0.7rem 1rem; margin: 1.25rem 0; }
    .scope { margin: 0; font-size: 0.9rem; color: var(--sl-color-gray-2); }
    .scopesrc { margin: 0.4rem 0 0; font-size: 0.8rem; color: var(--sl-color-gray-3); }
    /* A panel with a coloured edge, the same shape the share card and trace.svg use. */
    .banner { border: 1px solid var(--sl-color-gray-5); border-left-width: 4px; border-radius: 4px; padding: 0.7rem 1rem; margin: 1.25rem 0 0.9rem; background: var(--sl-color-gray-7, transparent); }
    .banner.go { border-left-color: var(--sl-color-green-high); }
    .banner.stop { border-left-color: var(--sl-color-red-high); }
    .banner.wait { border-left-color: var(--sl-color-orange-high); }
    .verdict { font-family: var(--__sl-font-mono); font-size: 1.05rem; font-weight: 700; margin: 0 0 0.15rem; }
    .verdict.go { color: var(--sl-color-green-high); }
    .verdict.stop { color: var(--sl-color-red-high); }
    .verdict.wait { color: var(--sl-color-orange-high); }
    .summary { margin: 0; color: var(--sl-color-gray-2); font-size: 0.92rem; }
    .trace { font-size: 0.88rem; }
    .trace th { font-weight: 600; color: var(--sl-color-gray-3); font-size: 0.8rem; text-transform: lowercase; }
    .trace th.n, .trace th.ms { text-align: right; }
    .src { border: 1px solid var(--sl-color-gray-5); border-radius: 4px; padding: 0.6rem 1rem 1rem; margin-top: 1.5rem; }
    .src > summary { cursor: pointer; font-weight: 600; font-size: 0.92rem; color: var(--sl-color-gray-2); }
    .acts { display: flex; align-items: center; gap: 0.6rem; margin-bottom: 0; }
    .pg { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; }
    @media (max-width: 72rem) { .pg { grid-template-columns: 1fr; } }
    .pg label { display: flex; flex-direction: column; gap: 0.25rem; font-weight: 600; }
    .hint { font-size: 0.85rem; color: var(--sl-color-gray-3); margin: 0 0 0.9rem; }
    .ex label { display: flex; flex-direction: column; gap: 0.25rem; font-weight: 600; margin-bottom: 0.8rem; font-size: 0.9rem; }
    .ex textarea { font-family: var(--__sl-font-mono); font-size: 0.8rem; line-height: 1.4; padding: 0.5rem; border: 1px solid var(--sl-color-gray-5); border-radius: 0.25rem; background: var(--sl-color-black); color: var(--sl-color-white); resize: vertical; }
    .ex .acts { flex-wrap: wrap; gap: 0.5rem; }
    .pg textarea { font-family: var(--__sl-font-mono); font-size: 0.8rem; line-height: 1.4; padding: 0.5rem; border: 1px solid var(--sl-color-gray-5); border-radius: 0.25rem; background: var(--sl-color-black); color: var(--sl-color-white); }
    .run, .copy { font: inherit; font-weight: 600; padding: 0.4rem 1rem; border-radius: 0.25rem; cursor: pointer; }
    .run { border: 1px solid var(--sl-color-accent); background: var(--sl-color-accent); color: var(--sl-color-black); }
    .copy { border: 1px solid var(--sl-color-gray-5); background: transparent; color: var(--sl-color-white); }
    .error { color: var(--sl-color-red); }
  </style>
</StarlightPage>
