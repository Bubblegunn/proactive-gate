{
  "spec_version": "1.6.0",
  "name": "my-policy/night-and-budget",
  "description": "Our policy: no normal messages 22:00 to 08:00 Istanbul time, at most 2 a day.",
  "policy": {
    "specVersion": "1.0.0",
    "checks": [
      { "id": "consent" },
      { "id": "quietHours", "priorityFloor": "critical" },
      { "id": "dailyBudget", "limit": 2 }
    ]
  },
  "tests": [
    {
      "description": "03:00 local, normal priority: held by quiet hours",
      "input": {
        "user": { "id": "ayse", "consent": true, "timezone": "Europe/Istanbul", "quietHours": { "start": "22:00", "end": "08:00" } },
        "candidate": { "id": "c1", "type": "reminder", "priority": "normal" },
        "now": "2026-09-04T00:00:00Z"
      },
      "expect": { "allowed": false, "rejectedBy": "quietHours", "nextAllowedAt": "2026-09-04T05:00:00.000Z", "trace": ["consent", "quietHours"] }
    },
    {
      "description": "midday local: allowed",
      "input": {
        "user": { "id": "ayse", "consent": true, "timezone": "Europe/Istanbul", "quietHours": { "start": "22:00", "end": "08:00" } },
        "candidate": { "id": "c2", "type": "reminder", "priority": "normal" },
        "now": "2026-09-04T09:00:00Z"
      },
      "expect": { "allowed": true, "trace": ["consent", "quietHours", "dailyBudget"] }
    }
  ]
}
