{
  "spec_version": "1.0.0",
  "since": "1.0.0",
  "name": "ordering/kill-switch",
  "description": "A kill switch that is on stops everything before consent is even read.",
  "policy": {
    "specVersion": "1.0.0",
    "checks": [
      {
        "id": "killSwitch",
        "on": true
      },
      {
        "id": "consent"
      }
    ]
  },
  "tests": [
    {
      "description": "rejected by the switch",
      "input": {
        "user": {
          "id": "u1",
          "consent": true,
          "proactiveEnabled": true,
          "mode": "normal",
          "intensity": "normal",
          "timezone": "Europe/Istanbul",
          "quietHours": {
            "start": "22:00",
            "end": "08:00"
          },
          "createdAt": "2026-01-01T00:00:00Z"
        },
        "candidate": {
          "id": "c1",
          "type": "reminder",
          "priority": "normal",
          "surfaces": [
            "push",
            "feed"
          ]
        },
        "now": "2026-09-04T09:00:00Z"
      },
      "expect": {
        "allowed": false,
        "rejectedBy": "killSwitch",
        "trace": [
          "killSwitch"
        ],
        "reason_pattern": "kill switch"
      }
    }
  ]
}
