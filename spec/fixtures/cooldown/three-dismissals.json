{
  "spec_version": "1.0.0",
  "since": "1.0.0",
  "name": "cooldown/three-dismissals",
  "description": "Three dismissals of a type within 30 days silence it for 7 days from the latest.",
  "policy": {
    "specVersion": "1.0.0",
    "checks": [
      {
        "id": "consent"
      },
      {
        "id": "dismissalCooldown",
        "dismissals": 3,
        "withinDays": 30,
        "silenceDays": 7
      }
    ]
  },
  "store_seed": {
    "cooldown:u1:reminder": "[1788264000000, 1788436800000, 1788523200000]"
  },
  "tests": [
    {
      "description": "silent one day after the third dismissal",
      "input": {
        "user": {
          "id": "u1",
          "consent": true,
          "proactiveEnabled": true,
          "mode": "normal",
          "intensity": "normal",
          "timezone": "Europe/Istanbul",
          "quietHours": {
            "start": "22:00",
            "end": "08:00"
          },
          "createdAt": "2026-01-01T00:00:00Z"
        },
        "candidate": {
          "id": "c1",
          "type": "reminder",
          "priority": "normal",
          "surfaces": [
            "push",
            "feed"
          ]
        },
        "now": "2026-09-05T12:00:00Z"
      },
      "expect": {
        "allowed": false,
        "rejectedBy": "dismissalCooldown",
        "trace": [
          "consent",
          "dismissalCooldown"
        ],
        "reason_pattern": "3 dismissals"
      }
    },
    {
      "description": "another type is unaffected",
      "input": {
        "user": {
          "id": "u1",
          "consent": true,
          "proactiveEnabled": true,
          "mode": "normal",
          "intensity": "normal",
          "timezone": "Europe/Istanbul",
          "quietHours": {
            "start": "22:00",
            "end": "08:00"
          },
          "createdAt": "2026-01-01T00:00:00Z"
        },
        "candidate": {
          "id": "c1",
          "type": "insight",
          "priority": "normal",
          "surfaces": [
            "push",
            "feed"
          ]
        },
        "now": "2026-09-05T12:00:00Z"
      },
      "expect": {
        "allowed": true,
        "trace": [
          "consent",
          "dismissalCooldown"
        ]
      }
    },
    {
      "description": "eight days after the third dismissal it speaks again",
      "input": {
        "user": {
          "id": "u1",
          "consent": true,
          "proactiveEnabled": true,
          "mode": "normal",
          "intensity": "normal",
          "timezone": "Europe/Istanbul",
          "quietHours": {
            "start": "22:00",
            "end": "08:00"
          },
          "createdAt": "2026-01-01T00:00:00Z"
        },
        "candidate": {
          "id": "c1",
          "type": "reminder",
          "priority": "normal",
          "surfaces": [
            "push",
            "feed"
          ]
        },
        "now": "2026-09-13T00:00:00Z"
      },
      "expect": {
        "allowed": true,
        "trace": [
          "consent",
          "dismissalCooldown"
        ]
      }
    }
  ]
}
