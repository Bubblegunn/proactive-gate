{
  "spec_version": "1.0.0",
  "since": "1.0.0",
  "name": "quiet-hours/dst-new-york",
  "description": "On 2026-03-08 New York springs forward at 02:00; 06:30Z is 01:30 EST, 07:30Z is 03:30 EDT.",
  "policy": {
    "specVersion": "1.0.0",
    "checks": [
      {
        "id": "consent"
      },
      {
        "id": "quietHours"
      }
    ]
  },
  "tests": [
    {
      "description": "06:30Z is 01:30 local, inside 22:00 to 07:00",
      "input": {
        "user": {
          "id": "u1",
          "consent": true,
          "proactiveEnabled": true,
          "mode": "normal",
          "intensity": "normal",
          "timezone": "America/New_York",
          "quietHours": {
            "start": "22:00",
            "end": "07:00"
          },
          "createdAt": "2026-01-01T00:00:00Z"
        },
        "candidate": {
          "id": "c1",
          "type": "reminder",
          "priority": "normal",
          "surfaces": [
            "push",
            "feed"
          ]
        },
        "now": "2026-03-08T06:30:00Z"
      },
      "expect": {
        "allowed": false,
        "rejectedBy": "quietHours",
        "trace": [
          "consent",
          "quietHours"
        ]
      }
    },
    {
      "description": "07:30Z is 03:30 local after the jump, still inside",
      "input": {
        "user": {
          "id": "u1",
          "consent": true,
          "proactiveEnabled": true,
          "mode": "normal",
          "intensity": "normal",
          "timezone": "America/New_York",
          "quietHours": {
            "start": "22:00",
            "end": "07:00"
          },
          "createdAt": "2026-01-01T00:00:00Z"
        },
        "candidate": {
          "id": "c1",
          "type": "reminder",
          "priority": "normal",
          "surfaces": [
            "push",
            "feed"
          ]
        },
        "now": "2026-03-08T07:30:00Z"
      },
      "expect": {
        "allowed": false,
        "rejectedBy": "quietHours",
        "trace": [
          "consent",
          "quietHours"
        ]
      }
    },
    {
      "description": "11:30Z is 07:30 local, outside",
      "input": {
        "user": {
          "id": "u1",
          "consent": true,
          "proactiveEnabled": true,
          "mode": "normal",
          "intensity": "normal",
          "timezone": "America/New_York",
          "quietHours": {
            "start": "22:00",
            "end": "07:00"
          },
          "createdAt": "2026-01-01T00:00:00Z"
        },
        "candidate": {
          "id": "c1",
          "type": "reminder",
          "priority": "normal",
          "surfaces": [
            "push",
            "feed"
          ]
        },
        "now": "2026-03-08T11:30:00Z"
      },
      "expect": {
        "allowed": true,
        "trace": [
          "consent",
          "quietHours"
        ]
      }
    }
  ]
}
