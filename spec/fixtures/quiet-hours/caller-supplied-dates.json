{
  "spec_version": "1.1.0",
  "since": "1.1.0",
  "name": "quiet-hours/caller-supplied-dates",
  "description": "A calendar date the caller supplies beats the weekday and the default, in both directions. There is no bundled holiday calendar.",
  "policy": {
    "specVersion": "1.0.0",
    "checks": [
      {
        "id": "consent"
      },
      {
        "id": "quietHours"
      }
    ]
  },
  "tests": [
    {
      "description": "noon on a date marked quiet all day rejects",
      "input": {
        "user": {
          "id": "u1",
          "consent": true,
          "proactiveEnabled": true,
          "mode": "normal",
          "intensity": "normal",
          "timezone": "Europe/Istanbul",
          "quietHours": {
            "default": {
              "start": "22:00",
              "end": "08:00"
            },
            "dates": {
              "2026-09-04": {
                "start": "00:00",
                "end": "23:59"
              },
              "2026-09-07": null
            }
          },
          "createdAt": "2026-01-01T00:00:00Z"
        },
        "candidate": {
          "id": "c1",
          "type": "reminder",
          "priority": "normal",
          "surfaces": [
            "push",
            "feed"
          ]
        },
        "now": "2026-09-04T09:00:00Z"
      },
      "expect": {
        "allowed": false,
        "trace": [
          "consent",
          "quietHours"
        ],
        "rejectedBy": "quietHours"
      }
    },
    {
      "description": "noon the next day is back to the default and passes",
      "input": {
        "user": {
          "id": "u1",
          "consent": true,
          "proactiveEnabled": true,
          "mode": "normal",
          "intensity": "normal",
          "timezone": "Europe/Istanbul",
          "quietHours": {
            "default": {
              "start": "22:00",
              "end": "08:00"
            },
            "dates": {
              "2026-09-04": {
                "start": "00:00",
                "end": "23:59"
              },
              "2026-09-07": null
            }
          },
          "createdAt": "2026-01-01T00:00:00Z"
        },
        "candidate": {
          "id": "c1",
          "type": "reminder",
          "priority": "normal",
          "surfaces": [
            "push",
            "feed"
          ]
        },
        "now": "2026-09-05T09:00:00Z"
      },
      "expect": {
        "allowed": true,
        "trace": [
          "consent",
          "quietHours"
        ]
      }
    },
    {
      "description": "23:30 on a date set to null passes, the default does not apply",
      "input": {
        "user": {
          "id": "u1",
          "consent": true,
          "proactiveEnabled": true,
          "mode": "normal",
          "intensity": "normal",
          "timezone": "Europe/Istanbul",
          "quietHours": {
            "default": {
              "start": "22:00",
              "end": "08:00"
            },
            "dates": {
              "2026-09-04": {
                "start": "00:00",
                "end": "23:59"
              },
              "2026-09-07": null
            }
          },
          "createdAt": "2026-01-01T00:00:00Z"
        },
        "candidate": {
          "id": "c1",
          "type": "reminder",
          "priority": "normal",
          "surfaces": [
            "push",
            "feed"
          ]
        },
        "now": "2026-09-07T20:30:00Z"
      },
      "expect": {
        "allowed": true,
        "trace": [
          "consent",
          "quietHours"
        ]
      }
    },
    {
      "description": "23:30 the following night falls back to the default and rejects",
      "input": {
        "user": {
          "id": "u1",
          "consent": true,
          "proactiveEnabled": true,
          "mode": "normal",
          "intensity": "normal",
          "timezone": "Europe/Istanbul",
          "quietHours": {
            "default": {
              "start": "22:00",
              "end": "08:00"
            },
            "dates": {
              "2026-09-04": {
                "start": "00:00",
                "end": "23:59"
              },
              "2026-09-07": null
            }
          },
          "createdAt": "2026-01-01T00:00:00Z"
        },
        "candidate": {
          "id": "c1",
          "type": "reminder",
          "priority": "normal",
          "surfaces": [
            "push",
            "feed"
          ]
        },
        "now": "2026-09-08T20:30:00Z"
      },
      "expect": {
        "allowed": false,
        "trace": [
          "consent",
          "quietHours"
        ],
        "rejectedBy": "quietHours"
      }
    }
  ]
}
