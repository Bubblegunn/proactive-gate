{
  "spec_version": "1.6.0",
  "since": "1.5.0",
  "name": "hold/snooze-end",
  "description": "A snooze rejection carries the instant the snooze ends.",
  "policy": {
    "specVersion": "1.0.0",
    "checks": [
      {
        "id": "consent"
      },
      {
        "id": "snooze"
      }
    ]
  },
  "tests": [
    {
      "description": "snoozed for another hour",
      "input": {
        "user": {
          "id": "u1",
          "consent": true,
          "timezone": "Europe/Istanbul",
          "snoozedUntil": "2026-09-04T10:00:00Z"
        },
        "candidate": {
          "id": "c1",
          "type": "reminder"
        },
        "now": "2026-09-04T09:00:00Z"
      },
      "expect": {
        "allowed": false,
        "rejectedBy": "snooze",
        "nextAllowedAt": "2026-09-04T10:00:00.000Z",
        "trace": [
          "consent",
          "snooze"
        ]
      }
    },
    {
      "description": "the snooze already ended: allowed, no answer",
      "input": {
        "user": {
          "id": "u1",
          "consent": true,
          "timezone": "Europe/Istanbul",
          "snoozedUntil": "2026-09-04T10:00:00Z"
        },
        "candidate": {
          "id": "c1",
          "type": "reminder"
        },
        "now": "2026-09-04T10:00:00Z"
      },
      "expect": {
        "allowed": true,
        "nextAllowedAt": null,
        "trace": [
          "consent",
          "snooze"
        ]
      }
    }
  ]
}
