{
  "spec_version": "1.6.0",
  "since": "1.5.0",
  "name": "hold/first-denying-check",
  "description": "The answer belongs to the check that denied, not to a later one: it is a lower bound, and evaluating again at that instant can be denied by the next check.",
  "policy": {
    "specVersion": "1.0.0",
    "checks": [
      {
        "id": "consent"
      },
      {
        "id": "quietHours",
        "priorityFloor": "high"
      },
      {
        "id": "dailyBudget",
        "limit": 1
      }
    ]
  },
  "store_seed": {
    "budget:u1:2026-09-05": "1"
  },
  "tests": [
    {
      "description": "quiet hours deny first, so the answer is the end of quiet hours",
      "input": {
        "user": {
          "id": "u1",
          "consent": true,
          "timezone": "Europe/Istanbul",
          "quietHours": {
            "start": "22:00",
            "end": "08:00"
          }
        },
        "candidate": {
          "id": "c1",
          "type": "reminder"
        },
        "now": "2026-09-04T20:30:00Z"
      },
      "expect": {
        "allowed": false,
        "rejectedBy": "quietHours",
        "nextAllowedAt": "2026-09-05T05:00:00.000Z",
        "trace": [
          "consent",
          "quietHours"
        ]
      }
    },
    {
      "description": "at that instant quiet hours are over and the exhausted budget denies, with its own answer",
      "input": {
        "user": {
          "id": "u1",
          "consent": true,
          "timezone": "Europe/Istanbul",
          "quietHours": {
            "start": "22:00",
            "end": "08:00"
          }
        },
        "candidate": {
          "id": "c1",
          "type": "reminder"
        },
        "now": "2026-09-05T05:00:00Z"
      },
      "expect": {
        "allowed": false,
        "rejectedBy": "dailyBudget",
        "nextAllowedAt": "2026-09-05T21:00:00.000Z",
        "trace": [
          "consent",
          "quietHours",
          "dailyBudget"
        ]
      }
    }
  ]
}
