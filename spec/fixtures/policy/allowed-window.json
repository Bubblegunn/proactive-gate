{
  "spec_version": "1.6.0",
  "since": "1.4.2",
  "name": "policy/allowed-window",
  "description": "allowedWindow is the check eight of the presets are built on, including the US TCPA calling hours, Korea's Network Act night window and Kakao's 08:00 to 20:50, and until 1.4.2 no fixture exercised it at all. A window is [start, end): the opening minute is inside the allowed window and the closing minute is outside it. An implementation that treated the window as closed at both ends passed the whole suite.",
  "policy": {
    "specVersion": "1.0.0",
    "checks": [
      {
        "id": "consent"
      },
      {
        "id": "allowedWindow",
        "start": "08:00",
        "end": "21:00",
        "timezone": "user"
      }
    ]
  },
  "tests": [
    {
      "description": "07:59 is one minute before the window opens",
      "input": {
        "user": {
          "id": "u1",
          "consent": true,
          "proactiveEnabled": true,
          "mode": "normal",
          "intensity": "normal",
          "timezone": "UTC",
          "createdAt": "2026-01-01T00:00:00Z"
        },
        "candidate": {
          "id": "c1",
          "type": "reminder",
          "priority": "normal",
          "surfaces": [
            "push",
            "feed"
          ]
        },
        "now": "2026-09-04T07:59:00Z"
      },
      "expect": {
        "allowed": false,
        "trace": [
          "consent",
          "allowedWindow"
        ],
        "rejectedBy": "allowedWindow"
      }
    },
    {
      "description": "08:00 is the minute the window opens, and is inside it",
      "input": {
        "user": {
          "id": "u1",
          "consent": true,
          "proactiveEnabled": true,
          "mode": "normal",
          "intensity": "normal",
          "timezone": "UTC",
          "createdAt": "2026-01-01T00:00:00Z"
        },
        "candidate": {
          "id": "c1",
          "type": "reminder",
          "priority": "normal",
          "surfaces": [
            "push",
            "feed"
          ]
        },
        "now": "2026-09-04T08:00:00Z"
      },
      "expect": {
        "allowed": true,
        "trace": [
          "consent",
          "allowedWindow"
        ]
      }
    },
    {
      "description": "20:59 is the last minute inside the window",
      "input": {
        "user": {
          "id": "u1",
          "consent": true,
          "proactiveEnabled": true,
          "mode": "normal",
          "intensity": "normal",
          "timezone": "UTC",
          "createdAt": "2026-01-01T00:00:00Z"
        },
        "candidate": {
          "id": "c1",
          "type": "reminder",
          "priority": "normal",
          "surfaces": [
            "push",
            "feed"
          ]
        },
        "now": "2026-09-04T20:59:00Z"
      },
      "expect": {
        "allowed": true,
        "trace": [
          "consent",
          "allowedWindow"
        ]
      }
    },
    {
      "description": "21:00 is the minute the window ends, and is outside it",
      "input": {
        "user": {
          "id": "u1",
          "consent": true,
          "proactiveEnabled": true,
          "mode": "normal",
          "intensity": "normal",
          "timezone": "UTC",
          "createdAt": "2026-01-01T00:00:00Z"
        },
        "candidate": {
          "id": "c1",
          "type": "reminder",
          "priority": "normal",
          "surfaces": [
            "push",
            "feed"
          ]
        },
        "now": "2026-09-04T21:00:00Z"
      },
      "expect": {
        "allowed": false,
        "trace": [
          "consent",
          "allowedWindow"
        ],
        "rejectedBy": "allowedWindow"
      }
    }
  ]
}
