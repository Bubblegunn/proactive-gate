{
  "spec_version": "1.4.1",
  "since": "1.4.1",
  "name": "clock/window-crossing-fall-back",
  "description": "A 22:00 to 02:00 window opens on 2026-10-31 in New York and is still open when the clock falls back at 06:00 UTC on Nov 1. The tail is defined on local minutes, so the repeated 01:00 to 01:59:59 stays quiet through both passes: a nominally four-hour window silences five real hours, 02:00Z to 07:00Z.",
  "policy": {
    "specVersion": "1.0.0",
    "checks": [
      {
        "id": "consent"
      },
      {
        "id": "quietHours"
      }
    ]
  },
  "tests": [
    {
      "description": "01:30Z is Oct 31 21:30 EDT, half an hour before the window opens",
      "input": {
        "user": {
          "id": "u1",
          "consent": true,
          "proactiveEnabled": true,
          "mode": "normal",
          "intensity": "normal",
          "timezone": "America/New_York",
          "quietHours": {
            "start": "22:00",
            "end": "02:00"
          },
          "createdAt": "2026-01-01T00:00:00Z"
        },
        "candidate": {
          "id": "c1",
          "type": "reminder",
          "priority": "normal",
          "surfaces": [
            "push",
            "feed"
          ]
        },
        "now": "2026-11-01T01:30:00Z"
      },
      "expect": {
        "allowed": true,
        "trace": [
          "consent",
          "quietHours"
        ]
      }
    },
    {
      "description": "02:00Z is Oct 31 22:00 EDT, the minute the window opens",
      "input": {
        "user": {
          "id": "u1",
          "consent": true,
          "proactiveEnabled": true,
          "mode": "normal",
          "intensity": "normal",
          "timezone": "America/New_York",
          "quietHours": {
            "start": "22:00",
            "end": "02:00"
          },
          "createdAt": "2026-01-01T00:00:00Z"
        },
        "candidate": {
          "id": "c2",
          "type": "reminder",
          "priority": "normal",
          "surfaces": [
            "push",
            "feed"
          ]
        },
        "now": "2026-11-01T02:00:00Z"
      },
      "expect": {
        "allowed": false,
        "rejectedBy": "quietHours",
        "trace": [
          "consent",
          "quietHours"
        ]
      }
    },
    {
      "description": "05:30Z is Nov 1 01:30 EDT, inside the tail on the first pass through the repeated hour",
      "input": {
        "user": {
          "id": "u1",
          "consent": true,
          "proactiveEnabled": true,
          "mode": "normal",
          "intensity": "normal",
          "timezone": "America/New_York",
          "quietHours": {
            "start": "22:00",
            "end": "02:00"
          },
          "createdAt": "2026-01-01T00:00:00Z"
        },
        "candidate": {
          "id": "c3",
          "type": "reminder",
          "priority": "normal",
          "surfaces": [
            "push",
            "feed"
          ]
        },
        "now": "2026-11-01T05:30:00Z"
      },
      "expect": {
        "allowed": false,
        "rejectedBy": "quietHours",
        "reason_pattern": "sat 2026-10-31",
        "trace": [
          "consent",
          "quietHours"
        ]
      }
    },
    {
      "description": "06:30Z is Nov 1 01:30 EST, inside the tail on the second pass after the fall-back",
      "input": {
        "user": {
          "id": "u1",
          "consent": true,
          "proactiveEnabled": true,
          "mode": "normal",
          "intensity": "normal",
          "timezone": "America/New_York",
          "quietHours": {
            "start": "22:00",
            "end": "02:00"
          },
          "createdAt": "2026-01-01T00:00:00Z"
        },
        "candidate": {
          "id": "c4",
          "type": "reminder",
          "priority": "normal",
          "surfaces": [
            "push",
            "feed"
          ]
        },
        "now": "2026-11-01T06:30:00Z"
      },
      "expect": {
        "allowed": false,
        "rejectedBy": "quietHours",
        "reason_pattern": "sat 2026-10-31",
        "trace": [
          "consent",
          "quietHours"
        ]
      }
    },
    {
      "description": "06:59:59Z is 01:59:59 EST, the last quiet second of the five real hours",
      "input": {
        "user": {
          "id": "u1",
          "consent": true,
          "proactiveEnabled": true,
          "mode": "normal",
          "intensity": "normal",
          "timezone": "America/New_York",
          "quietHours": {
            "start": "22:00",
            "end": "02:00"
          },
          "createdAt": "2026-01-01T00:00:00Z"
        },
        "candidate": {
          "id": "c5",
          "type": "reminder",
          "priority": "normal",
          "surfaces": [
            "push",
            "feed"
          ]
        },
        "now": "2026-11-01T06:59:59Z"
      },
      "expect": {
        "allowed": false,
        "rejectedBy": "quietHours",
        "reason_pattern": "sat 2026-10-31",
        "trace": [
          "consent",
          "quietHours"
        ]
      }
    },
    {
      "description": "07:00Z is 02:00 EST, the window's exclusive end, so the silence is over",
      "input": {
        "user": {
          "id": "u1",
          "consent": true,
          "proactiveEnabled": true,
          "mode": "normal",
          "intensity": "normal",
          "timezone": "America/New_York",
          "quietHours": {
            "start": "22:00",
            "end": "02:00"
          },
          "createdAt": "2026-01-01T00:00:00Z"
        },
        "candidate": {
          "id": "c6",
          "type": "reminder",
          "priority": "normal",
          "surfaces": [
            "push",
            "feed"
          ]
        },
        "now": "2026-11-01T07:00:00Z"
      },
      "expect": {
        "allowed": true,
        "trace": [
          "consent",
          "quietHours"
        ]
      }
    }
  ]
}
