{
  "spec_version": "1.4.1",
  "since": "1.4.1",
  "name": "clock/autumn-back-repeated-hour",
  "description": "On 2026-11-01 New York falls back at 06:00 UTC, so local 01:00 to 01:59:59 happens twice, once as EDT and once as EST. A quiet window of 00:30 to 01:30 is defined on local minutes, so it covers both passes through the repeated hour: a 60-minute window silences 90 real minutes, from 04:30Z to 06:30Z.",
  "policy": {
    "specVersion": "1.0.0",
    "checks": [
      {
        "id": "consent"
      },
      {
        "id": "quietHours"
      }
    ]
  },
  "tests": [
    {
      "description": "04:29:59Z is 00:29:59 EDT, the last minute before the window opens",
      "input": {
        "user": {
          "id": "u1",
          "consent": true,
          "proactiveEnabled": true,
          "mode": "normal",
          "intensity": "normal",
          "timezone": "America/New_York",
          "quietHours": {
            "start": "00:30",
            "end": "01:30"
          },
          "createdAt": "2026-01-01T00:00:00Z"
        },
        "candidate": {
          "id": "c1",
          "type": "reminder",
          "priority": "normal",
          "surfaces": [
            "push",
            "feed"
          ]
        },
        "now": "2026-11-01T04:29:59Z"
      },
      "expect": {
        "allowed": true,
        "trace": [
          "consent",
          "quietHours"
        ]
      }
    },
    {
      "description": "04:45Z is 00:45 EDT, inside the window",
      "input": {
        "user": {
          "id": "u1",
          "consent": true,
          "proactiveEnabled": true,
          "mode": "normal",
          "intensity": "normal",
          "timezone": "America/New_York",
          "quietHours": {
            "start": "00:30",
            "end": "01:30"
          },
          "createdAt": "2026-01-01T00:00:00Z"
        },
        "candidate": {
          "id": "c2",
          "type": "reminder",
          "priority": "normal",
          "surfaces": [
            "push",
            "feed"
          ]
        },
        "now": "2026-11-01T04:45:00Z"
      },
      "expect": {
        "allowed": false,
        "rejectedBy": "quietHours",
        "trace": [
          "consent",
          "quietHours"
        ]
      }
    },
    {
      "description": "05:15Z is 01:15 EDT, the first pass through the repeated hour, still inside",
      "input": {
        "user": {
          "id": "u1",
          "consent": true,
          "proactiveEnabled": true,
          "mode": "normal",
          "intensity": "normal",
          "timezone": "America/New_York",
          "quietHours": {
            "start": "00:30",
            "end": "01:30"
          },
          "createdAt": "2026-01-01T00:00:00Z"
        },
        "candidate": {
          "id": "c3",
          "type": "reminder",
          "priority": "normal",
          "surfaces": [
            "push",
            "feed"
          ]
        },
        "now": "2026-11-01T05:15:00Z"
      },
      "expect": {
        "allowed": false,
        "rejectedBy": "quietHours",
        "trace": [
          "consent",
          "quietHours"
        ]
      }
    },
    {
      "description": "06:15Z is 01:15 EST, the second pass an hour later; the window covers it too",
      "input": {
        "user": {
          "id": "u1",
          "consent": true,
          "proactiveEnabled": true,
          "mode": "normal",
          "intensity": "normal",
          "timezone": "America/New_York",
          "quietHours": {
            "start": "00:30",
            "end": "01:30"
          },
          "createdAt": "2026-01-01T00:00:00Z"
        },
        "candidate": {
          "id": "c4",
          "type": "reminder",
          "priority": "normal",
          "surfaces": [
            "push",
            "feed"
          ]
        },
        "now": "2026-11-01T06:15:00Z"
      },
      "expect": {
        "allowed": false,
        "rejectedBy": "quietHours",
        "trace": [
          "consent",
          "quietHours"
        ]
      }
    },
    {
      "description": "06:30Z is 01:30 EST, the window's exclusive end on the second pass, so the repeated hour is finally over",
      "input": {
        "user": {
          "id": "u1",
          "consent": true,
          "proactiveEnabled": true,
          "mode": "normal",
          "intensity": "normal",
          "timezone": "America/New_York",
          "quietHours": {
            "start": "00:30",
            "end": "01:30"
          },
          "createdAt": "2026-01-01T00:00:00Z"
        },
        "candidate": {
          "id": "c5",
          "type": "reminder",
          "priority": "normal",
          "surfaces": [
            "push",
            "feed"
          ]
        },
        "now": "2026-11-01T06:30:00Z"
      },
      "expect": {
        "allowed": true,
        "trace": [
          "consent",
          "quietHours"
        ]
      }
    }
  ]
}
