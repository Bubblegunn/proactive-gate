{
  "spec_version": "1.4.1",
  "since": "1.4.1",
  "name": "clock/non-hour-offsets",
  "description": "Three zones that break whole-hour assumptions. Kathmandu sits at +5:45, so its weekday turns at 18:15 UTC and a Saturday window covers instants UTC still calls Friday (6.6: the weekday comes from the local date, not the instant). Chatham Islands springs forward from +12:45 to +13:45 at 02:45 local, so a window running through the jump loses its middle 60 minutes and silences only its first 15. Etc/GMT+5 is UTC-5: the POSIX-style name inverts the sign.",
  "policy": {
    "specVersion": "1.0.0",
    "checks": [
      {
        "id": "consent"
      },
      {
        "id": "quietHours"
      }
    ]
  },
  "tests": [
    {
      "description": "18:30Z on a UTC Friday is already Saturday 00:15 in Kathmandu; the Saturday window is in force",
      "input": {
        "user": {
          "id": "u1",
          "consent": true,
          "proactiveEnabled": true,
          "mode": "normal",
          "intensity": "normal",
          "timezone": "Asia/Kathmandu",
          "quietHours": {
            "days": {
              "sat": {
                "start": "00:00",
                "end": "06:00"
              }
            }
          },
          "createdAt": "2026-01-01T00:00:00Z"
        },
        "candidate": {
          "id": "c1",
          "type": "reminder",
          "priority": "normal",
          "surfaces": [
            "push",
            "feed"
          ]
        },
        "now": "2026-09-04T18:30:00Z"
      },
      "expect": {
        "allowed": false,
        "rejectedBy": "quietHours",
        "trace": [
          "consent",
          "quietHours"
        ]
      }
    },
    {
      "description": "18:00Z is Friday 23:45 in Kathmandu; Friday has no window and yesterday's does not reach this late",
      "input": {
        "user": {
          "id": "u1",
          "consent": true,
          "proactiveEnabled": true,
          "mode": "normal",
          "intensity": "normal",
          "timezone": "Asia/Kathmandu",
          "quietHours": {
            "days": {
              "sat": {
                "start": "00:00",
                "end": "06:00"
              }
            }
          },
          "createdAt": "2026-01-01T00:00:00Z"
        },
        "candidate": {
          "id": "c2",
          "type": "reminder",
          "priority": "normal",
          "surfaces": [
            "push",
            "feed"
          ]
        },
        "now": "2026-09-04T18:00:00Z"
      },
      "expect": {
        "allowed": true,
        "trace": [
          "consent",
          "quietHours"
        ]
      }
    },
    {
      "description": "13:59:59Z on Sep 26 is Sep 27 02:44:59 at +12:45 in the Chatham Islands, inside a window that is about to be truncated by the jump",
      "input": {
        "user": {
          "id": "u2",
          "consent": true,
          "proactiveEnabled": true,
          "mode": "normal",
          "intensity": "normal",
          "timezone": "Pacific/Chatham",
          "quietHours": {
            "start": "02:30",
            "end": "03:30"
          },
          "createdAt": "2026-01-01T00:00:00Z"
        },
        "candidate": {
          "id": "c3",
          "type": "reminder",
          "priority": "normal",
          "surfaces": [
            "push",
            "feed"
          ]
        },
        "now": "2026-09-26T13:59:59Z"
      },
      "expect": {
        "allowed": false,
        "rejectedBy": "quietHours",
        "trace": [
          "consent",
          "quietHours"
        ]
      }
    },
    {
      "description": "14:00Z lands on Sep 27 03:45 at +13:45; local 02:45 to 03:44:59 never occurred, so a nominally 60-minute window silenced only its first 15 real minutes",
      "input": {
        "user": {
          "id": "u2",
          "consent": true,
          "proactiveEnabled": true,
          "mode": "normal",
          "intensity": "normal",
          "timezone": "Pacific/Chatham",
          "quietHours": {
            "start": "02:30",
            "end": "03:30"
          },
          "createdAt": "2026-01-01T00:00:00Z"
        },
        "candidate": {
          "id": "c4",
          "type": "reminder",
          "priority": "normal",
          "surfaces": [
            "push",
            "feed"
          ]
        },
        "now": "2026-09-26T14:00:00Z"
      },
      "expect": {
        "allowed": true,
        "trace": [
          "consent",
          "quietHours"
        ]
      }
    },
    {
      "description": "12:30Z is 07:30 at UTC-5; the zone named Etc/GMT+5 is behind Greenwich, not ahead of it",
      "input": {
        "user": {
          "id": "u3",
          "consent": true,
          "proactiveEnabled": true,
          "mode": "normal",
          "intensity": "normal",
          "timezone": "Etc/GMT+5",
          "quietHours": {
            "start": "06:00",
            "end": "08:00"
          },
          "createdAt": "2026-01-01T00:00:00Z"
        },
        "candidate": {
          "id": "c5",
          "type": "reminder",
          "priority": "normal",
          "surfaces": [
            "push",
            "feed"
          ]
        },
        "now": "2026-09-04T12:30:00Z"
      },
      "expect": {
        "allowed": false,
        "rejectedBy": "quietHours",
        "trace": [
          "consent",
          "quietHours"
        ]
      }
    },
    {
      "description": "13:30Z is 08:30 at UTC-5, past the end of the window",
      "input": {
        "user": {
          "id": "u3",
          "consent": true,
          "proactiveEnabled": true,
          "mode": "normal",
          "intensity": "normal",
          "timezone": "Etc/GMT+5",
          "quietHours": {
            "start": "06:00",
            "end": "08:00"
          },
          "createdAt": "2026-01-01T00:00:00Z"
        },
        "candidate": {
          "id": "c6",
          "type": "reminder",
          "priority": "normal",
          "surfaces": [
            "push",
            "feed"
          ]
        },
        "now": "2026-09-04T13:30:00Z"
      },
      "expect": {
        "allowed": true,
        "trace": [
          "consent",
          "quietHours"
        ]
      }
    }
  ]
}
