{
  "spec_version": "1.2.0",
  "since": "1.0.0",
  "name": "shadow/reject-continues",
  "description": "A shadow check records its rejection and evaluation continues.",
  "policy": {
    "specVersion": "1.0.0",
    "checks": [
      {
        "id": "consent"
      },
      {
        "id": "quietHours",
        "shadow": true
      },
      {
        "id": "dailyBudget",
        "limit": 5
      }
    ]
  },
  "store_seed": {
    "budget:full:2026-09-04": "5"
  },
  "tests": [
    {
      "description": "23:30 local: quiet hours would reject; the decision is allowed and lists it",
      "input": {
        "user": {
          "id": "u1",
          "consent": true,
          "proactiveEnabled": true,
          "mode": "normal",
          "intensity": "normal",
          "timezone": "Europe/Istanbul",
          "quietHours": {
            "start": "22:00",
            "end": "08:00"
          },
          "createdAt": "2026-01-01T00:00:00Z"
        },
        "candidate": {
          "id": "c1",
          "type": "reminder",
          "priority": "normal",
          "surfaces": [
            "push",
            "feed"
          ]
        },
        "now": "2026-09-04T20:30:00Z"
      },
      "expect": {
        "allowed": true,
        "trace": [
          "consent",
          "quietHours",
          "dailyBudget"
        ],
        "shadowed": [
          "quietHours"
        ]
      }
    },
    {
      "description": "noon: nothing shadowed",
      "input": {
        "user": {
          "id": "u1",
          "consent": true,
          "proactiveEnabled": true,
          "mode": "normal",
          "intensity": "normal",
          "timezone": "Europe/Istanbul",
          "quietHours": {
            "start": "22:00",
            "end": "08:00"
          },
          "createdAt": "2026-01-01T00:00:00Z"
        },
        "candidate": {
          "id": "c1",
          "type": "reminder",
          "priority": "normal",
          "surfaces": [
            "push",
            "feed"
          ]
        },
        "now": "2026-09-04T09:00:00Z"
      },
      "expect": {
        "allowed": true,
        "trace": [
          "consent",
          "quietHours",
          "dailyBudget"
        ],
        "shadowed": []
      }
    },
    {
      "description": "a real rejection later still rejects, with the shadow listed",
      "input": {
        "user": {
          "id": "full",
          "consent": true,
          "proactiveEnabled": true,
          "mode": "normal",
          "intensity": "normal",
          "timezone": "Europe/Istanbul",
          "quietHours": {
            "start": "22:00",
            "end": "08:00"
          },
          "createdAt": "2026-01-01T00:00:00Z"
        },
        "candidate": {
          "id": "c2",
          "type": "reminder",
          "priority": "normal",
          "surfaces": [
            "push",
            "feed"
          ]
        },
        "now": "2026-09-04T20:30:00Z"
      },
      "expect": {
        "allowed": false,
        "rejectedBy": "dailyBudget",
        "trace": [
          "consent",
          "quietHours",
          "dailyBudget"
        ],
        "shadowed": [
          "quietHours"
        ]
      }
    }
  ]
}
