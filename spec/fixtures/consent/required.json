{
  "spec_version": "1.1.0",
  "since": "1.0.0",
  "name": "consent/required",
  "description": "Consent is the first thing about the person that is checked.",
  "policy": {
    "specVersion": "1.0.0",
    "checks": [
      {
        "id": "consent"
      },
      {
        "id": "enabled"
      }
    ]
  },
  "tests": [
    {
      "description": "no consent",
      "input": {
        "user": {
          "id": "u1",
          "consent": false,
          "proactiveEnabled": true,
          "mode": "normal",
          "intensity": "normal",
          "timezone": "Europe/Istanbul",
          "quietHours": {
            "start": "22:00",
            "end": "08:00"
          },
          "createdAt": "2026-01-01T00:00:00Z"
        },
        "candidate": {
          "id": "c1",
          "type": "reminder",
          "priority": "normal",
          "surfaces": [
            "push",
            "feed"
          ]
        },
        "now": "2026-09-04T09:00:00Z"
      },
      "expect": {
        "allowed": false,
        "rejectedBy": "consent",
        "trace": [
          "consent"
        ]
      }
    },
    {
      "description": "consent given, disabled profile",
      "input": {
        "user": {
          "id": "u1",
          "consent": true,
          "proactiveEnabled": false,
          "mode": "normal",
          "intensity": "normal",
          "timezone": "Europe/Istanbul",
          "quietHours": {
            "start": "22:00",
            "end": "08:00"
          },
          "createdAt": "2026-01-01T00:00:00Z"
        },
        "candidate": {
          "id": "c1",
          "type": "reminder",
          "priority": "normal",
          "surfaces": [
            "push",
            "feed"
          ]
        },
        "now": "2026-09-04T09:00:00Z"
      },
      "expect": {
        "allowed": false,
        "rejectedBy": "enabled",
        "trace": [
          "consent",
          "enabled"
        ]
      }
    },
    {
      "description": "consent given, undefined proactiveEnabled defaults to on",
      "input": {
        "user": {
          "id": "u2",
          "consent": true
        },
        "candidate": {
          "id": "c1",
          "type": "reminder",
          "priority": "normal",
          "surfaces": [
            "push",
            "feed"
          ]
        },
        "now": "2026-09-04T09:00:00Z"
      },
      "expect": {
        "allowed": true,
        "trace": [
          "consent",
          "enabled"
        ]
      }
    }
  ]
}
