{
  "spec_version": "1.2.0",
  "since": "1.0.0",
  "name": "budget/bypass-priority",
  "description": "A bypass priority passes the budget without reading or consuming it.",
  "policy": {
    "specVersion": "1.0.0",
    "checks": [
      {
        "id": "consent"
      },
      {
        "id": "dailyBudget",
        "limit": 1,
        "bypassPriority": "critical"
      }
    ]
  },
  "store_seed": {
    "budget:u1:2026-09-04": "1"
  },
  "tests": [
    {
      "description": "critical passes a full budget and commit consumes nothing",
      "input": {
        "user": {
          "id": "u1",
          "consent": true,
          "proactiveEnabled": true,
          "mode": "normal",
          "intensity": "normal",
          "timezone": "Europe/Istanbul",
          "quietHours": {
            "start": "22:00",
            "end": "08:00"
          },
          "createdAt": "2026-01-01T00:00:00Z"
        },
        "candidate": {
          "id": "c1",
          "type": "reminder",
          "priority": "critical",
          "surfaces": [
            "push",
            "feed"
          ]
        },
        "now": "2026-09-04T09:00:00Z"
      },
      "commit": true,
      "expect": {
        "allowed": true,
        "trace": [
          "consent",
          "dailyBudget"
        ],
        "commit": true,
        "store_after": {
          "budget:u1:2026-09-04": "1"
        }
      }
    },
    {
      "description": "normal is rejected",
      "input": {
        "user": {
          "id": "u1",
          "consent": true,
          "proactiveEnabled": true,
          "mode": "normal",
          "intensity": "normal",
          "timezone": "Europe/Istanbul",
          "quietHours": {
            "start": "22:00",
            "end": "08:00"
          },
          "createdAt": "2026-01-01T00:00:00Z"
        },
        "candidate": {
          "id": "c2",
          "type": "reminder",
          "priority": "normal",
          "surfaces": [
            "push",
            "feed"
          ]
        },
        "now": "2026-09-04T09:00:00Z"
      },
      "expect": {
        "allowed": false,
        "rejectedBy": "dailyBudget",
        "trace": [
          "consent",
          "dailyBudget"
        ]
      }
    }
  ]
}
