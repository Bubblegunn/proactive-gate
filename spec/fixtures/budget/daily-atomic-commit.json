{
  "spec_version": "1.1.0",
  "since": "1.0.0",
  "name": "budget/daily-atomic-commit",
  "description": "evaluate reads the counter, commit consumes it, the extra commit is refused.",
  "policy": {
    "specVersion": "1.0.0",
    "checks": [
      {
        "id": "consent"
      },
      {
        "id": "dailyBudget",
        "limit": 2
      }
    ]
  },
  "store_seed": {
    "budget:u1:2026-09-04": "1"
  },
  "tests": [
    {
      "description": "one used, one left",
      "input": {
        "user": {
          "id": "u1",
          "consent": true,
          "proactiveEnabled": true,
          "mode": "normal",
          "intensity": "normal",
          "timezone": "Europe/Istanbul",
          "quietHours": {
            "start": "22:00",
            "end": "08:00"
          },
          "createdAt": "2026-01-01T00:00:00Z"
        },
        "candidate": {
          "id": "c1",
          "type": "reminder",
          "priority": "normal",
          "surfaces": [
            "push",
            "feed"
          ]
        },
        "now": "2026-09-04T09:00:00Z"
      },
      "commit": true,
      "expect": {
        "allowed": true,
        "trace": [
          "consent",
          "dailyBudget"
        ],
        "commit": true,
        "store_after": {
          "budget:u1:2026-09-04": "2"
        }
      }
    },
    {
      "description": "two used: rejected at evaluate",
      "input": {
        "user": {
          "id": "u1",
          "consent": true,
          "proactiveEnabled": true,
          "mode": "normal",
          "intensity": "normal",
          "timezone": "Europe/Istanbul",
          "quietHours": {
            "start": "22:00",
            "end": "08:00"
          },
          "createdAt": "2026-01-01T00:00:00Z"
        },
        "candidate": {
          "id": "c2",
          "type": "reminder",
          "priority": "normal",
          "surfaces": [
            "push",
            "feed"
          ]
        },
        "now": "2026-09-04T09:00:00Z"
      },
      "expect": {
        "allowed": false,
        "rejectedBy": "dailyBudget",
        "trace": [
          "consent",
          "dailyBudget"
        ],
        "reason_pattern": "2 used \\(2\\)"
      }
    },
    {
      "description": "next local day resets (00:30 Istanbul)",
      "input": {
        "user": {
          "id": "u1",
          "consent": true,
          "proactiveEnabled": true,
          "mode": "normal",
          "intensity": "normal",
          "timezone": "Europe/Istanbul",
          "quietHours": {
            "start": "22:00",
            "end": "08:00"
          },
          "createdAt": "2026-01-01T00:00:00Z"
        },
        "candidate": {
          "id": "c3",
          "type": "reminder",
          "priority": "normal",
          "surfaces": [
            "push",
            "feed"
          ]
        },
        "now": "2026-09-04T21:30:00Z"
      },
      "commit": true,
      "expect": {
        "allowed": true,
        "trace": [
          "consent",
          "dailyBudget"
        ],
        "commit": true,
        "store_after": {
          "budget:u1:2026-09-05": "1"
        }
      }
    }
  ]
}
