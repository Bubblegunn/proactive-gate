{
  "spec_version": "1.1.0",
  "since": "1.0.0",
  "name": "budget/near-limit",
  "description": "A pass close to the limit carries nearLimit.",
  "policy": {
    "specVersion": "1.0.0",
    "checks": [
      {
        "id": "consent"
      },
      {
        "id": "dailyBudget",
        "limit": 5,
        "nearLimit": 0.8
      }
    ]
  },
  "store_seed": {
    "budget:u1:2026-09-04": "4",
    "budget:u9:2026-09-04": "3"
  },
  "tests": [
    {
      "description": "4 of 5 used",
      "input": {
        "user": {
          "id": "u1",
          "consent": true,
          "proactiveEnabled": true,
          "mode": "normal",
          "intensity": "normal",
          "timezone": "Europe/Istanbul",
          "quietHours": {
            "start": "22:00",
            "end": "08:00"
          },
          "createdAt": "2026-01-01T00:00:00Z"
        },
        "candidate": {
          "id": "c1",
          "type": "reminder",
          "priority": "normal",
          "surfaces": [
            "push",
            "feed"
          ]
        },
        "now": "2026-09-04T09:00:00Z"
      },
      "expect": {
        "allowed": true,
        "trace": [
          "consent",
          "dailyBudget"
        ],
        "nearLimit": [
          {
            "check": "dailyBudget",
            "used": 4,
            "limit": 5
          }
        ]
      }
    },
    {
      "description": "3 of 5 used carries nothing",
      "input": {
        "user": {
          "id": "u9",
          "consent": true,
          "proactiveEnabled": true,
          "mode": "normal",
          "intensity": "normal",
          "timezone": "Europe/Istanbul",
          "quietHours": {
            "start": "22:00",
            "end": "08:00"
          },
          "createdAt": "2026-01-01T00:00:00Z"
        },
        "candidate": {
          "id": "c2",
          "type": "reminder",
          "priority": "normal",
          "surfaces": [
            "push",
            "feed"
          ]
        },
        "now": "2026-09-04T09:00:00Z"
      },
      "expect": {
        "allowed": true,
        "trace": [
          "consent",
          "dailyBudget"
        ],
        "nearLimit": []
      }
    }
  ]
}
