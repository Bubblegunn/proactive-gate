{
  "spec_version": "1.0.0",
  "since": "1.0.0",
  "name": "defer/snooze-as-defer",
  "description": "snooze with defer true produces a deferred decision with retryAt.",
  "policy": {
    "specVersion": "1.0.0",
    "checks": [
      {
        "id": "consent"
      },
      {
        "id": "snooze",
        "defer": true
      },
      {
        "id": "dailyBudget"
      }
    ]
  },
  "tests": [
    {
      "description": "snoozed: deferred until the snooze ends",
      "input": {
        "user": {
          "id": "u1",
          "consent": true,
          "proactiveEnabled": true,
          "mode": "normal",
          "intensity": "normal",
          "timezone": "Europe/Istanbul",
          "quietHours": {
            "start": "22:00",
            "end": "08:00"
          },
          "createdAt": "2026-01-01T00:00:00Z",
          "snoozedUntil": "2026-09-04T10:00:00Z"
        },
        "candidate": {
          "id": "c1",
          "type": "reminder",
          "priority": "normal",
          "surfaces": [
            "push",
            "feed"
          ]
        },
        "now": "2026-09-04T09:00:00Z"
      },
      "expect": {
        "allowed": false,
        "deferredBy": "snooze",
        "retryAt": "2026-09-04T10:00:00.000Z",
        "trace": [
          "consent",
          "snooze"
        ]
      }
    },
    {
      "description": "snooze in the past: passes",
      "input": {
        "user": {
          "id": "u1",
          "consent": true,
          "proactiveEnabled": true,
          "mode": "normal",
          "intensity": "normal",
          "timezone": "Europe/Istanbul",
          "quietHours": {
            "start": "22:00",
            "end": "08:00"
          },
          "createdAt": "2026-01-01T00:00:00Z",
          "snoozedUntil": "2026-09-04T08:00:00Z"
        },
        "candidate": {
          "id": "c1",
          "type": "reminder",
          "priority": "normal",
          "surfaces": [
            "push",
            "feed"
          ]
        },
        "now": "2026-09-04T09:00:00Z"
      },
      "expect": {
        "allowed": true,
        "trace": [
          "consent",
          "snooze",
          "dailyBudget"
        ]
      }
    },
    {
      "description": "a deferred decision cannot be committed",
      "input": {
        "user": {
          "id": "u1",
          "consent": true,
          "proactiveEnabled": true,
          "mode": "normal",
          "intensity": "normal",
          "timezone": "Europe/Istanbul",
          "quietHours": {
            "start": "22:00",
            "end": "08:00"
          },
          "createdAt": "2026-01-01T00:00:00Z",
          "snoozedUntil": "2026-09-04T10:00:00Z"
        },
        "candidate": {
          "id": "c2",
          "type": "reminder",
          "priority": "normal",
          "surfaces": [
            "push",
            "feed"
          ]
        },
        "now": "2026-09-04T09:00:00Z"
      },
      "commit": true,
      "expect": {
        "allowed": false,
        "deferredBy": "snooze",
        "retryAt": "2026-09-04T10:00:00.000Z",
        "trace": [
          "consent",
          "snooze"
        ],
        "commit": false
      }
    }
  ]
}
