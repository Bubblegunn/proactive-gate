        },
        "candidate": {
          "id": "c6",
          "type": "insight",
          "kind": "commitment"
        },
        "now": "2026-09-04T12:00:00Z"
      },
      "commit": true,
      "expect": {
        "allowed": true,
        "trace": [
          "killSwitch",
          "crisisQuiet",
          "consent",
          "consent:marketing",
          "enabled",
          "mode",
          "snooze",
          "mute",
          "quietHours",
          "trustRamp",
          "dismissalCooldown",
          "freshness",
          "silence",
          "dedupe",
          "deadHours",
          "dailyBudget"
        ],
        "commit": true,
        "store_after": {
          "budget:u6:2026-09-04": "3"
        }
      }
    },
    {
      "description": "a normal candidate on the same exhausted budget is refused by dailyBudget",
      "input": {
        "user": {
          "id": "u7",
          "consent": true,
          "deviceTimezone": "Europe/Istanbul",
          "createdAt": "2026-07-01T00:00:00Z",
          "consents": {
            "marketing": true
          }
        },
        "candidate": {
          "id": "c7",
          "type": "insight"
        },
        "now": "2026-09-04T12:00:00Z"
      },
      "expect": {
        "allowed": false,
        "rejectedBy": "dailyBudget",
        "reason_pattern": "daily budget of 3 used",
        "trace": [
          "killSwitch",
          "crisisQuiet",
          "consent",
          "consent:marketing",
          "enabled",
          "mode",
          "snooze",
          "mute",
          "quietHours",
          "trustRamp",
          "dismissalCooldown",
          "freshness",
          "silence",
          "dedupe",
          "deadHours",
          "dailyBudget"
        ]
      }
    },
    {
      "description": "crisis quiet refuses first, before consent or the missing zone are looked at",
      "input": {
        "user": {
          "id": "u8",
          "consent": true,
          "crisisUntil": "2026-09-04T18:00:00Z",
          "createdAt": "2026-07-01T00:00:00Z"
        },
        "candidate": {
          "id": "c8",
          "type": "insight"
        },
        "now": "2026-09-04T12:00:00Z"
      },
      "expect": {
        "allowed": false,
        "rejectedBy": "crisisQuiet",
        "reason_pattern": "crisis",
        "trace": [
          "killSwitch",
          "crisisQuiet"
        ]
      }
    },
