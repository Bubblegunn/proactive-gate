{
  "spec_version": "1.6.0",
  "since": "1.6.0",
  "name": "lessons/preset-assistant-nudge",
  "description": "The assistantNudge preset in order: the kill switch flag, crisis quiet first, consent with a push fail-closed mode, marketing consent unless transactional, quiet hours that reject a missing zone, the trust ramp with request, the dismissal cooldown, freshness, silence, dedupe, dead hours and the daily limit. A commitment passes the budget and spends nothing.",
  "policy": {
    "specVersion": "1.0.0",
    "checks": [
      {
        "preset": "assistantNudge"
      }
    ]
  },
  "store_seed": {
    "budget:u7:2026-09-04": "3",
    "budget:u6:2026-09-04": "3",
    "budget:u51:2026-09-04": "3",
    "dedupe:u51:order-51-shipped": "1"
  },
  "tests": [
    {
      "description": "a non-transactional candidate without marketing consent is rejected by consent:marketing",
      "input": {
        "user": {
          "id": "u1",
          "consent": true,
          "deviceTimezone": "Europe/Istanbul",
          "createdAt": "2026-07-01T00:00:00Z",
          "consents": {}
        },
        "candidate": {
          "id": "c1",
          "type": "insight"
        },
        "now": "2026-09-04T12:00:00Z"
      },
      "expect": {
        "allowed": false,
        "rejectedBy": "consent:marketing",
        "reason_pattern": "marketing",
        "trace": [
          "killSwitch",
          "crisisQuiet",
          "consent",
          "consent:marketing"
        ]
      }
    },
    {
      "description": "the same user with a transactional candidate passes the marketing consent, and the whole nudge runs",
      "input": {
        "user": {
          "id": "u2",
          "consent": true,
          "deviceTimezone": "Europe/Istanbul",
          "createdAt": "2026-07-01T00:00:00Z",
          "consents": {}
        },
        "candidate": {
          "id": "c2",
          "type": "insight",
          "transactional": true
        },
        "now": "2026-09-04T12:00:00Z"
      },
      "expect": {
        "allowed": true,
        "trace": [
          "killSwitch",
          "crisisQuiet",
          "consent",
          "consent:marketing",
          "enabled",
          "mode",
          "snooze",
          "mute",
          "quietHours",
          "trustRamp",
          "dismissalCooldown",
          "freshness",
          "silence",
          "dedupe",
          "deadHours",
          "dailyBudget"
        ]
      }
    },
    {
      "description": "a user with no time zone of any kind is rejected by quietHours, which names the time zone",
      "input": {
        "user": {
          "id": "u3",
          "consent": true,
          "createdAt": "2026-07-01T00:00:00Z",
          "consents": {
            "marketing": true
          }
        },
        "candidate": {
          "id": "c3",
          "type": "insight"
        },
        "now": "2026-09-04T12:00:00Z"
      },
      "expect": {
        "allowed": false,
        "rejectedBy": "quietHours",
        "reason_pattern": "time zone",
        "trace": [
          "killSwitch",
          "crisisQuiet",
          "consent",
          "consent:marketing",
          "enabled",
          "mode",
          "snooze",
          "mute",
          "quietHours"
        ]
      }
    },
    {
      "description": "a requested message on a new account passes the trust ramp",
      "input": {
        "user": {
          "id": "u4",
          "consent": true,
          "deviceTimezone": "Europe/Istanbul",
          "createdAt": "2026-09-04T11:00:00Z",
          "consents": {
            "marketing": true
          }
        },
        "candidate": {
          "id": "c4",
          "type": "insight",
          "priority": "low",
          "requested": true
        },
        "now": "2026-09-04T12:00:00Z"
      },
      "expect": {
        "allowed": true,
        "trace": [
          "killSwitch",
          "crisisQuiet",
          "consent",
          "consent:marketing",
          "enabled",
          "mode",
          "snooze",
          "mute",
          "quietHours",
          "trustRamp",
          "dismissalCooldown",
          "freshness",
          "silence",
          "dedupe",
          "deadHours",
          "dailyBudget"
        ]
      }
    },
    {
      "description": "the same new account without a request is held by trustRamp at low priority",
      "input": {
        "user": {
          "id": "u5",
          "consent": true,
          "deviceTimezone": "Europe/Istanbul",
          "createdAt": "2026-09-04T11:00:00Z",
          "consents": {
            "marketing": true
          }
        },
        "candidate": {
          "id": "c5",
          "type": "insight",
          "priority": "low"
        },
        "now": "2026-09-04T12:00:00Z"
      },
      "expect": {
        "allowed": false,
        "rejectedBy": "trustRamp",
        "reason_pattern": "trust ramp",
        "trace": [
          "killSwitch",
          "crisisQuiet",
          "consent",
          "consent:marketing",
          "enabled",
          "mode",
          "snooze",
          "mute",
          "quietHours",
          "trustRamp"
        ]
      }
    },
    {
      "description": "a commitment passes the exhausted daily budget and spends nothing",
      "input": {
        "user": {
          "id": "u6",
          "consent": true,
          "deviceTimezone": "Europe/Istanbul",
          "createdAt": "2026-07-01T00:00:00Z",
          "consents": {
            "marketing": true
