          "mute",
          "quietHours",
          "trustRamp",
          "dismissalCooldown",
          "freshness"
        ]
      }
    },
    {
      "description": "proactiveEnabled set to false in the runtime flags stops the nudge at the kill switch",
      "input": {
        "user": {
          "id": "u11",
          "consent": true,
          "deviceTimezone": "Europe/Istanbul",
          "createdAt": "2026-07-01T00:00:00Z",
          "consents": {
            "marketing": true
          }
        },
        "candidate": {
          "id": "c11",
          "type": "insight"
        },
        "now": "2026-09-04T12:00:00Z",
        "flags": {
          "proactiveEnabled": false
        }
      },
      "expect": {
        "allowed": false,
        "rejectedBy": "killSwitch",
        "reason_pattern": "kill switch",
        "trace": [
          "killSwitch"
        ]
      }
    },
    {
      "description": "with consent unknown, the preset keeps feed and drops push, so a feed candidate goes through",
      "input": {
        "user": {
          "id": "u12",
          "consent": true,
          "deviceTimezone": "Europe/Istanbul",
