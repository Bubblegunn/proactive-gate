          "enabled",
          "mode",
          "snooze",
          "mute",
          "quietHours",
          "trustRamp",
          "dismissalCooldown",
          "freshness",
          "silence",
          "dedupe",
          "deadHours",
          "dailyBudget"
        ]
      }
    },
    {
