{
  "spec_version": "1.6.0",
  "since": "1.6.0",
  "name": "lessons/zone-reject-missing",
  "description": "quietHours with onMissingTimezone reject. A user with no usable zone is rejected with a reason that names the time zone, with or without quiet hours. The placeholder UTC is no zone unless a valid deviceTimezone is present. 12:00Z is 15:00 in Istanbul, outside quiet hours. 20:00Z is 23:00 in Istanbul (quiet) and 20:00 in UTC (not quiet).",
  "policy": {
    "specVersion": "1.0.0",
    "checks": [
      { "id": "consent" },
      { "id": "quietHours", "onMissingTimezone": "reject" }
    ]
  },
  "tests": [
    {
      "description": "no timezone and no device zone: rejected",
      "input": {
        "user": { "id": "u1", "consent": true, "proactiveEnabled": true, "mode": "normal", "intensity": "normal", "quietHours": { "start": "22:00", "end": "08:00" }, "createdAt": "2026-01-01T00:00:00Z" },
        "candidate": { "id": "c1", "type": "reminder", "priority": "normal", "surfaces": ["push", "feed"] },
        "now": "2026-09-04T12:00:00Z"
      },
      "expect": { "allowed": false, "rejectedBy": "quietHours", "reason_pattern": "time zone", "trace": ["consent", "quietHours"] }
    },
    {
      "description": "the placeholder UTC with no device zone counts as no zone: rejected",
      "input": {
        "user": { "id": "u1", "consent": true, "proactiveEnabled": true, "mode": "normal", "intensity": "normal", "timezone": "UTC", "quietHours": { "start": "22:00", "end": "08:00" }, "createdAt": "2026-01-01T00:00:00Z" },
        "candidate": { "id": "c1", "type": "reminder", "priority": "normal", "surfaces": ["push", "feed"] },
        "now": "2026-09-04T12:00:00Z"
      },
      "expect": { "allowed": false, "rejectedBy": "quietHours", "reason_pattern": "time zone", "trace": ["consent", "quietHours"] }
    },
    {
      "description": "the placeholder UTC with a valid device zone uses the device zone: passes",
      "input": {
        "user": { "id": "u1", "consent": true, "proactiveEnabled": true, "mode": "normal", "intensity": "normal", "timezone": "UTC", "deviceTimezone": "Europe/Istanbul", "quietHours": { "start": "22:00", "end": "08:00" }, "createdAt": "2026-01-01T00:00:00Z" },
        "candidate": { "id": "c1", "type": "reminder", "priority": "normal", "surfaces": ["push", "feed"] },
        "now": "2026-09-04T12:00:00Z"
      },
      "expect": { "allowed": true, "surfaces": ["push", "feed"], "trace": ["consent", "quietHours"] }
    },
    {
      "description": "a real timezone is used: passes",
      "input": {
        "user": { "id": "u1", "consent": true, "proactiveEnabled": true, "mode": "normal", "intensity": "normal", "timezone": "Europe/Istanbul", "quietHours": { "start": "22:00", "end": "08:00" }, "createdAt": "2026-01-01T00:00:00Z" },
        "candidate": { "id": "c1", "type": "reminder", "priority": "normal", "surfaces": ["push", "feed"] },
        "now": "2026-09-04T12:00:00Z"
      },
      "expect": { "allowed": true, "surfaces": ["push", "feed"], "trace": ["consent", "quietHours"] }
    },
    {
      "description": "no quiet hours and no zone: rejected, because the check rejects before it looks at quiet hours",
      "input": {
        "user": { "id": "u1", "consent": true, "proactiveEnabled": true, "mode": "normal", "intensity": "normal", "createdAt": "2026-01-01T00:00:00Z" },
        "candidate": { "id": "c1", "type": "reminder", "priority": "normal", "surfaces": ["push", "feed"] },
        "now": "2026-09-04T12:00:00Z"
      },
      "expect": { "allowed": false, "rejectedBy": "quietHours", "reason_pattern": "time zone", "trace": ["consent", "quietHours"] }
    },
    {
      "description": "no quiet hours and a valid device zone: passes",
      "input": {
        "user": { "id": "u1", "consent": true, "proactiveEnabled": true, "mode": "normal", "intensity": "normal", "deviceTimezone": "Europe/Istanbul", "createdAt": "2026-01-01T00:00:00Z" },
        "candidate": { "id": "c1", "type": "reminder", "priority": "normal", "surfaces": ["push", "feed"] },
        "now": "2026-09-04T12:00:00Z"
      },
      "expect": { "allowed": true, "surfaces": ["push", "feed"], "trace": ["consent", "quietHours"] }
    },
    {
      "description": "the placeholder UTC with a device zone that is quiet at the instant: rejected by the device zone",
      "input": {
        "user": { "id": "u1", "consent": true, "proactiveEnabled": true, "mode": "normal", "intensity": "normal", "timezone": "UTC", "deviceTimezone": "Europe/Istanbul", "quietHours": { "start": "22:00", "end": "08:00" }, "createdAt": "2026-01-01T00:00:00Z" },
        "candidate": { "id": "c1", "type": "reminder", "priority": "normal", "surfaces": ["push", "feed"] },
        "now": "2026-09-04T20:00:00Z"
      },
      "expect": { "allowed": false, "rejectedBy": "quietHours", "reason_pattern": "quiet hours 22:00 to 08:00", "trace": ["consent", "quietHours"] }
    }
  ]
}
