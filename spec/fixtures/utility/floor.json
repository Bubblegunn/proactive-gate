{
  "spec_version": "1.2.0",
  "since": "1.0.0",
  "name": "utility/floor",
  "description": "utilityFloor rejects when pAccept is below tau = cFA / (cFA + pNeed * cFN).",
  "policy": {
    "specVersion": "1.0.0",
    "checks": [
      {
        "id": "consent"
      },
      {
        "id": "utilityFloor",
        "costFalseAlarm": 1,
        "costMissedHelp": 2
      }
    ]
  },
  "tests": [
    {
      "description": "pAccept 0.41, pNeed 0.4: tau 0.556, rejected",
      "input": {
        "user": {
          "id": "u1",
          "consent": true,
          "proactiveEnabled": true,
          "mode": "normal",
          "intensity": "normal",
          "timezone": "Europe/Istanbul",
          "quietHours": {
            "start": "22:00",
            "end": "08:00"
          },
          "createdAt": "2026-01-01T00:00:00Z"
        },
        "candidate": {
          "id": "c1",
          "type": "reminder",
          "priority": "normal",
          "surfaces": [
            "push",
            "feed"
          ],
          "pAccept": 0.41,
          "pNeed": 0.4
        },
        "now": "2026-09-04T09:00:00Z"
      },
      "expect": {
        "allowed": false,
        "rejectedBy": "utilityFloor",
        "trace": [
          "consent",
          "utilityFloor"
        ],
        "reason_pattern": "pAccept 0.41 < tau 0.556"
      }
    },
    {
      "description": "pAccept 0.6 clears it",
      "input": {
        "user": {
          "id": "u1",
          "consent": true,
          "proactiveEnabled": true,
          "mode": "normal",
          "intensity": "normal",
          "timezone": "Europe/Istanbul",
          "quietHours": {
            "start": "22:00",
            "end": "08:00"
          },
          "createdAt": "2026-01-01T00:00:00Z"
        },
        "candidate": {
          "id": "c1",
          "type": "reminder",
          "priority": "normal",
          "surfaces": [
            "push",
            "feed"
          ],
          "pAccept": 0.6,
          "pNeed": 0.4
        },
        "now": "2026-09-04T09:00:00Z"
      },
      "expect": {
        "allowed": true,
        "trace": [
          "consent",
          "utilityFloor"
        ]
      }
    },
    {
      "description": "pNeed defaults to 1: tau 0.333, pAccept 0.4 passes",
      "input": {
        "user": {
          "id": "u1",
          "consent": true,
          "proactiveEnabled": true,
          "mode": "normal",
          "intensity": "normal",
          "timezone": "Europe/Istanbul",
          "quietHours": {
            "start": "22:00",
            "end": "08:00"
          },
          "createdAt": "2026-01-01T00:00:00Z"
        },
        "candidate": {
          "id": "c1",
          "type": "reminder",
          "priority": "normal",
          "surfaces": [
            "push",
            "feed"
          ],
          "pAccept": 0.4
        },
        "now": "2026-09-04T09:00:00Z"
      },
      "expect": {
        "allowed": true,
        "trace": [
          "consent",
          "utilityFloor"
        ]
      }
    },
    {
      "description": "no pAccept: the check skips",
      "input": {
        "user": {
          "id": "u1",
          "consent": true,
          "proactiveEnabled": true,
          "mode": "normal",
          "intensity": "normal",
          "timezone": "Europe/Istanbul",
          "quietHours": {
            "start": "22:00",
            "end": "08:00"
          },
          "createdAt": "2026-01-01T00:00:00Z"
        },
        "candidate": {
          "id": "c1",
          "type": "reminder",
          "priority": "normal",
          "surfaces": [
            "push",
            "feed"
          ]
        },
        "now": "2026-09-04T09:00:00Z"
      },
      "expect": {
        "allowed": true,
        "trace": [
          "consent",
          "utilityFloor"
        ]
      }
    }
  ]
}
