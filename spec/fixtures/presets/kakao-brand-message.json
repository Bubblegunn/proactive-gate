{
  "spec_version": "1.2.0",
  "since": "1.0.0",
  "name": "presets/kakao-brand-message",
  "description": "kakaoBrandMessage runs 08:00 to 20:50 Korea time regardless of the recipient's zone.",
  "policy": {
    "specVersion": "1.0.0",
    "checks": [
      {
        "preset": "kakaoBrandMessage"
      }
    ]
  },
  "tests": [
    {
      "description": "21:00 KST rejects even for a user in Istanbul",
      "input": {
        "user": {
          "id": "u1",
          "consent": true,
          "proactiveEnabled": true,
          "mode": "normal",
          "intensity": "normal",
          "timezone": "Europe/Istanbul",
          "quietHours": {
            "start": "22:00",
            "end": "08:00"
          },
          "createdAt": "2026-01-01T00:00:00Z",
          "consents": {
            "ad": true
          }
        },
        "candidate": {
          "id": "c1",
          "type": "reminder",
          "priority": "normal",
          "surfaces": [
            "push",
            "feed"
          ]
        },
        "now": "2026-09-04T12:00:00Z"
      },
      "expect": {
        "allowed": false,
        "rejectedBy": "window:kakao",
        "trace": [
          "consent:ad",
          "window:kakao"
        ]
      }
    },
    {
      "description": "10:00 KST passes",
      "input": {
        "user": {
          "id": "u1",
          "consent": true,
          "proactiveEnabled": true,
          "mode": "normal",
          "intensity": "normal",
          "timezone": "Europe/Istanbul",
          "quietHours": {
            "start": "22:00",
            "end": "08:00"
          },
          "createdAt": "2026-01-01T00:00:00Z",
          "consents": {
            "ad": true
          }
        },
        "candidate": {
          "id": "c1",
          "type": "reminder",
          "priority": "normal",
          "surfaces": [
            "push",
            "feed"
          ]
        },
        "now": "2026-09-04T01:00:00Z"
      },
      "expect": {
        "allowed": true,
        "trace": [
          "consent:ad",
          "window:kakao"
        ]
      }
    }
  ]
}
