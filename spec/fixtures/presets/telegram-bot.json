{
  "spec_version": "1.1.0",
  "since": "1.0.0",
  "name": "presets/telegram-bot",
  "description": "telegramBot limits one message a second and twenty a minute per channel.",
  "policy": {
    "specVersion": "1.0.0",
    "checks": [
      {
        "preset": "telegramBot"
      }
    ]
  },
  "tests": [
    {
      "description": "first message in the second",
      "input": {
        "user": {
          "id": "u1",
          "consent": true,
          "proactiveEnabled": true,
          "mode": "normal",
          "intensity": "normal",
          "timezone": "Europe/Istanbul",
          "quietHours": {
            "start": "22:00",
            "end": "08:00"
          },
          "createdAt": "2026-01-01T00:00:00Z"
        },
        "candidate": {
          "id": "c1",
          "type": "reminder",
          "priority": "normal",
          "surfaces": [
            "push",
            "feed"
          ],
          "channel": "chat-1"
        },
        "now": "2026-09-04T09:00:00Z"
      },
      "commit": true,
      "expect": {
        "allowed": true,
        "trace": [
          "rate:1/s",
          "rate:20/min"
        ],
        "commit": true
      }
    },
    {
      "description": "second message in the same second is rejected",
      "input": {
        "user": {
          "id": "u1",
          "consent": true,
          "proactiveEnabled": true,
          "mode": "normal",
          "intensity": "normal",
          "timezone": "Europe/Istanbul",
          "quietHours": {
            "start": "22:00",
            "end": "08:00"
          },
          "createdAt": "2026-01-01T00:00:00Z"
        },
        "candidate": {
          "id": "c2",
          "type": "reminder",
          "priority": "normal",
          "surfaces": [
            "push",
            "feed"
          ],
          "channel": "chat-1"
        },
        "now": "2026-09-04T09:00:00Z"
      },
      "expect": {
        "allowed": false,
        "rejectedBy": "rate:1/s",
        "trace": [
          "rate:1/s"
        ]
      }
    },
    {
      "description": "another channel is unaffected",
      "input": {
        "user": {
          "id": "u1",
          "consent": true,
          "proactiveEnabled": true,
          "mode": "normal",
          "intensity": "normal",
          "timezone": "Europe/Istanbul",
          "quietHours": {
            "start": "22:00",
            "end": "08:00"
          },
          "createdAt": "2026-01-01T00:00:00Z"
        },
        "candidate": {
          "id": "c3",
          "type": "reminder",
          "priority": "normal",
          "surfaces": [
            "push",
            "feed"
          ],
          "channel": "chat-2"
        },
        "now": "2026-09-04T09:00:00Z"
      },
      "expect": {
        "allowed": true,
        "trace": [
          "rate:1/s",
          "rate:20/min"
        ]
      }
    },
    {
      "description": "next second on the first channel passes",
      "input": {
        "user": {
          "id": "u1",
          "consent": true,
          "proactiveEnabled": true,
          "mode": "normal",
          "intensity": "normal",
          "timezone": "Europe/Istanbul",
          "quietHours": {
            "start": "22:00",
            "end": "08:00"
          },
          "createdAt": "2026-01-01T00:00:00Z"
        },
        "candidate": {
          "id": "c4",
          "type": "reminder",
          "priority": "normal",
          "surfaces": [
            "push",
            "feed"
          ],
          "channel": "chat-1"
        },
        "now": "2026-09-04T09:00:01Z"
      },
      "expect": {
        "allowed": true,
        "trace": [
          "rate:1/s",
          "rate:20/min"
        ]
      }
    }
  ]
}
