{
  "spec_version": "1.2.0",
  "since": "1.2.0",
  "name": "dedupe/already-delivered",
  "description": "A key claimed inside the window rejects the second attempt at the same event.",
  "policy": {
    "specVersion": "1.0.0",
    "checks": [
      {
        "id": "consent"
      },
      {
        "id": "dedupe",
        "windowSeconds": 3600
      }
    ]
  },
  "store_seed": {
    "dedupe:u1:order-42-shipped": "1"
  },
  "tests": [
    {
      "description": "the same event arriving again is refused",
      "input": {
        "user": {
          "id": "u1",
          "consent": true,
          "proactiveEnabled": true,
          "mode": "normal",
          "intensity": "normal",
          "timezone": "Europe/Istanbul",
          "createdAt": "2026-01-01T00:00:00Z"
        },
        "candidate": {
          "id": "c2",
          "type": "reminder",
          "priority": "normal",
          "surfaces": [
            "push"
          ],
          "dedupeKey": "order-42-shipped"
        },
        "now": "2026-09-05T12:00:00Z"
      },
      "expect": {
        "allowed": false,
        "rejectedBy": "dedupe",
        "trace": [
          "consent",
          "dedupe"
        ],
        "reason_pattern": "already delivered"
      }
    },
    {
      "description": "a different event on the same user is unaffected",
      "input": {
        "user": {
          "id": "u1",
          "consent": true,
          "proactiveEnabled": true,
          "mode": "normal",
          "intensity": "normal",
          "timezone": "Europe/Istanbul",
          "createdAt": "2026-01-01T00:00:00Z"
        },
        "candidate": {
          "id": "c3",
          "type": "reminder",
          "priority": "normal",
          "surfaces": [
            "push"
          ],
          "dedupeKey": "order-43-shipped"
        },
        "now": "2026-09-05T12:00:00Z"
      },
      "expect": {
        "allowed": true,
        "trace": [
          "consent",
          "dedupe"
        ]
      }
    }
  ]
}
